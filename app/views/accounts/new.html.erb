<header class="page-title">
  <h1>New Account</h1>
  <%= link_to "Cancel", accounts_path, class: "button small secondary" %>
</header>

<main>
  <div class="card">
    <%= form_with model: @account do |form| %>
      <% if @account.errors.any? %>
        <div class="form-errors">
          <ul>
            <% @account.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="field">
        <%= form.label :name %>
        <%= form.text_field :name, required: true %>
      </div>

      <%= form.submit "Add Account" %>
    <% end %>
  </div>
</main>
