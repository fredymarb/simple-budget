<header>
  <h1>All Accounts</h1>
</header>

<main>
  <ul>
    <% @accounts.each do |account| %>
      <li><%= account.name %>: <%= currency_symbol %><%= Money.minor_to_decimal(account.transactions.sum(:amount_minor), exponent: Money::EXPONENTS["USD"]) %></li>
    <% end %>
  </ul>
</main>

<footer>
  <%= render BottomNavigationComponent.new(month: @month) %>
</footer>