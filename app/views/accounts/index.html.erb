<header>
  <h1>All Accounts</h1>
</header>

<main>
  <ul class="row-list">
    <% @accounts.each do |account| %>
      <% balance = account.transactions.sum(&:amount_minor) %>
      <li>
        <%= link_to edit_account_path(account), class: "row-link" do %>
          <span class="title"><%= account.name %></span>
          <span class="amount <%= balance.negative? ? "negative" : "positive" %>"><%= display_money(balance) %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <%= link_to "Create New Account", new_account_path, class: "button" %>
</main>

<footer>
  <%= render BottomNavigationComponent.new(month: @month) %>
</footer>
