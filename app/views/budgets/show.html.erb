
<div class="app-shell">
  <header>
    <%= render BudgetCalenderComponent.new(month: @month) %>

    <%# Sign out button%>
    <%= button_to "Sign Out", destroy_user_session_path, method: :delete %>
  </header>

  <main>
    <h2>Summary</h2>

    <p>Total Balance: <%= currency_symbol %><%= Money.minor_to_decimal(@total_balance, exponent: Money::EXPONENTS["USD"]) %></p>
    <p>Total Income: <%= currency_symbol %><%= Money.minor_to_decimal(@monthly_income, exponent: Money::EXPONENTS["USD"]) %></p>
    <p>Total Expenses: <%= currency_symbol %><%= Money.minor_to_decimal(@monthly_expenses, exponent: Money::EXPONENTS["USD"]) %></p>

    <h2>Income</h2>

    <ul>
      <% @income_by_category.each do |(_id, category_name, _kind), amount| %>
        <li>
          <%= category_name %>: <%= currency_symbol %><%= Money.minor_to_decimal(amount, exponent: Money::EXPONENTS["USD"]) %>
        </li>
      <% end %>
    </ul>

    <h2>Expenses</h2>

    <ul>
      <% @expense_by_category.each do |(_id, category_name, _kind), amount| %>
        <li>
          <%= category_name %>: <%= currency_symbol %><%= Money.minor_to_decimal(amount.abs, exponent: Money::EXPONENTS["USD"]) %>
        </li>
      <% end %>
    </ul>

    <%= link_to "Add Transaction", new_transaction_path %>
  </main>

  <footer>
    <%= render BottomNavigationComponent.new(month: @month) %>
  </footer>
</div>