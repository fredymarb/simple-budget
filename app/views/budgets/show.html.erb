
<div class="app-shell">
  <header>
    <%= render BudgetCalenderComponent.new(month: @month) %>

    <%# Sign out button%>
    <%= button_to "Sign Out", destroy_user_session_path, method: :delete %>
  </header>

  <main>
    <h2>Summary</h2>

    <p>Total Balance: <%= number_to_currency(@total_balance) %></p>
    <p>Total Income: <%= number_to_currency(@monthly_income) %></p>
    <p>Total Expenses: <%= number_to_currency(@monthly_expenses) %></p>

    <h2>Income</h2>

    <ul>
      <% @income_by_category.each do |(_id, category_name, _kind), amount| %>
        <li>
          <%= category_name %>: <%= number_to_currency(amount) %>
        </li>
      <% end %>
    </ul>

    <h2>Expenses</h2>

    <ul>
      <% @expense_by_category.each do |(_id, category_name, _kind), amount| %>
        <li>
          <%= category_name %>: <%= number_to_currency(amount) %>
        </li>
      <% end %>
    </ul>

    <%= link_to "Add Transaction", new_transaction_path %>
  </main>

  <%# TODO: make footer a component %>
  <footer>
    <a href="<%= root_path %>">Home</a>
    <a href="#">Insights</a>
    <a href="<%= transactions_path(month: @month.strftime("%Y-%m")) %>">Transactions</a>
    <a href="#">Accounts</a>
  </footer>
</div>