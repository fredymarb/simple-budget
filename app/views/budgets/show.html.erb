
<div class="app-shell">
  <header>
    <%= render BudgetCalenderComponent.new(month: @month) %>

    <%# Sign out button%>
    <%= button_to "Sign Out", destroy_user_session_path, method: :delete %>
  </header>

  <main>
    <h2>Summary</h2>

    <p>Total Balance: <%= display_money(@total_balance) %></p>
    <p>Total Income: <%= display_money(@monthly_income) %></p>
    <p>Total Expenses: <%= display_money(@monthly_expenses) %></p>

    <h2>Income</h2>

    <ul>
      <% @income_by_category.each do |(_id, category_name, _kind), amount| %>
        <li>
          <%= category_name %>: <%= display_money(amount) %>
        </li>
      <% end %>
    </ul>

    <h2>Expenses</h2>

    <ul>
      <% @expense_by_category.each do |(_id, category_name, _kind), amount| %>
        <li>
          <%= category_name %>: <%= display_money(amount.abs) %>
        </li>
      <% end %>
    </ul>

    <%= link_to "Add Transaction", new_transaction_path %>
  </main>

  <footer>
    <%= render BottomNavigationComponent.new(month: @month) %>
  </footer>
</div>