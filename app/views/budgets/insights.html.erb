<header>
  <%= render BudgetCalenderComponent.new(month: @month) %>
</header>

<main>
  <div class="page-heading">
    <div>
      <p class="eyebrow">YOUR MONEY, IN FOCUS</p>
      <h1>Insights</h1>
    </div>
    <span class="period-badge"><%= @month.strftime("%B %Y") %></span>
  </div>

  <section class="card stat-row insights-summary" aria-label="This month's summary">
    <div class="stat">
      <span class="label">Income</span>
      <strong class="amount income"><%= display_money(@insights[:current_month_summary][:income]) %></strong>
    </div>
    <div class="stat">
      <span class="label">Expenses</span>
      <strong class="amount expense"><%= display_money(@insights[:current_month_summary][:expense].abs) %></strong>
    </div>
    <div class="stat">
      <span class="label">Net</span>
      <strong class="amount <%= @insights[:current_month_summary][:net].negative? ? "expense" : "income" %>"><%= display_money(@insights[:current_month_summary][:net]) %></strong>
    </div>
  </section>

  <section class="card stat-row averages-summary" aria-label="Monthly averages">
    <div class="stat">
      <span class="label">Avg Monthly Income</span>
      <strong class="amount income"><%= display_money(@insights[:average_monthly_income]) %></strong>
    </div>
    <div class="stat">
      <span class="label">Avg Monthly Expense</span>
      <strong class="amount expense"><%= display_money(@insights[:average_monthly_expense]) %></strong>
    </div>
    <div class="stat">
      <span class="label">Savings Rate</span>
      <strong class="amount"><%= @insights[:savings_rate] %>%</strong>
    </div>
  </section>

  <section class="card trend-card">
    <div class="section-heading">
      <div>
        <p class="eyebrow">THE BIG PICTURE</p>
        <h2>12-month trends</h2>
      </div>
      <span class="chart-legend"><i class="legend-income"></i>Income <i class="legend-expense"></i>Expenses</span>
    </div>
    <% if @insights[:monthly_trends].any? %>
      <% trend_max = @insights[:monthly_trends].flat_map { |trend| [ trend[:income].abs, trend[:expense].abs ] }.max || 0 %>
      <ul class="trend-list">
        <% @insights[:monthly_trends].each do |month_data| %>
          <li class="trend-row">
            <span class="trend-month"><%= month_data[:month].strftime("%b %y") %></span>
            <span class="trend-bars" aria-hidden="true">
              <i class="trend-bar trend-income" style="width: <%= trend_max.zero? ? 0 : (month_data[:income].abs.to_f / trend_max * 100).round %>%"></i>
              <i class="trend-bar trend-expense" style="width: <%= trend_max.zero? ? 0 : (month_data[:expense].abs.to_f / trend_max * 100).round %>%"></i>
            </span>
            <span class="trend-amounts">
              <span class="amount positive"><%= display_money(month_data[:income]) %></span>
              <span class="amount negative"><%= display_money(month_data[:expense]) %></span>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="muted">No transaction history available.</p>
    <% end %>
  </section>

  <section class="card">
    <h2>Top Expenses</h2>
    <% if @insights[:expense_by_category].empty? %>
      <p class="muted">No expenses this month.</p>
    <% else %>
      <ul class="breakdown">
        <% @insights[:expense_by_category].each do |category| %>
          <li>
            <span><%= category[:name] %></span>
            <span class="amount negative"><%= display_money(category[:amount]) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="card">
    <h2>Income Sources</h2>
    <% if @insights[:income_by_category].empty? %>
      <p class="muted">No income this month.</p>
    <% else %>
      <ul class="breakdown">
        <% @insights[:income_by_category].each do |category| %>
          <li>
            <span><%= category[:name] %></span>
            <span class="amount positive"><%= display_money(category[:amount]) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>

<%= link_to "+", new_transaction_path, class: "fab", "aria-label": "Add transaction" %>

<footer>
  <%= render BottomNavigationComponent.new(month: @month) %>
</footer>
