<div class="app-shell">
  <header>
    <%= render BudgetCalenderComponent.new(month: @month) %>
  </header>

  <main>
    <h1>All Transactions</h1>

    <ul>
      <% @monthly_transactions.group_by(&:date).each do |date, transactions| %>
        <li>
          <strong><%= date.strftime("%B %d, %Y") %></strong>
          <ul>
            <% transactions.each do |transaction| %>
              <li>
                <a href="<%= edit_transaction_path(transaction) %>">
                  [<%= transaction.category.name %> : <%= display_money(transaction.amount_minor) %>]
                </a>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </main>

  <footer>
    <%= render BottomNavigationComponent.new(month: @month) %>
  </footer>
</div>
