<div class="app-shell">
  <header>
    <%= render BudgetCalenderComponent.new(month: @month) %>
  </header>

  <main>
    <h1>All Transactions</h1>

    <ul>
      <% @monthly_transactions.group_by(&:date).each do |date, transactions| %>
        <li>
          <strong><%= date.strftime("%B %d, %Y") %></strong>
          <ul>
            <% transactions.each do |transaction| %>
              <% next if transaction.transfer? && transaction.amount_minor.positive? %>
              <li>
                <% if transaction.transfer? %>
                  <% accounts = @transfer_accounts[transaction.transfer_group_id] || {} %>
                  <%= link_to edit_transaction_path(transaction) do %>
                    Transfer: <%= accounts[:source] || transaction.account.name %> →
                    <%= accounts[:destination] || "Unknown account" %>
                    (<%= display_money(transaction.amount_minor.abs) %>)
                  <% end %>
                <% else %>
                  <%= link_to edit_transaction_path(transaction) do %>
                    <%= transaction.category.name %>: <%= display_money(transaction.amount_minor) %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </main>

  <footer>
    <%= render BottomNavigationComponent.new(month: @month) %>
  </footer>
</div>
