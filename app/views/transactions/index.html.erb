<header>
  <%= render BudgetCalenderComponent.new(month: @month) %>
</header>

<main>
  <h1>All Transactions</h1>

  <% if @transactions_by_date.empty? %>
    <p class="empty">No transactions this month.</p>
  <% end %>

  <% @transactions_by_date.each do |date, entries| %>
    <section>
      <h2 class="date-heading"><%= date.strftime("%B %d, %Y") %></h2>
      <ul class="row-list">
        <%= render TransactionListItemComponent.with_collection(entries) %>
      </ul>
    </section>
  <% end %>
</main>

<%= link_to "+", new_transaction_path(month: @month.strftime("%Y-%m")), class: "fab", "aria-label": "Add transaction" %>

<footer>
  <%= render BottomNavigationComponent.new(month: @month) %>
</footer>
