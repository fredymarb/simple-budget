<div class="app-shell">
  <header>
    <%# TODO: Fix this component's navigation buttons to take user 
      # to transactions monthly page, instead of to budget's monthly page 
    %>
    <%= render BudgetCalenderComponent.new(month: @month) %>
  </header>

  <main>
    <h1>All Transactions</h1>

    <ul>
      <% @monthly_transactions.group_by(&:date).each do |date, transactions| %>
        <li>
          <%# format date as "Month Day, Year" %>
          <strong><%= date.strftime("%B %d, %Y") %></strong>
          <ul>
            <% transactions.each do |transaction| %>
              <li>
                <a href="<%= edit_transaction_path(transaction) %>">
                  [<%= transaction.category.name %> : <%= currency_symbol %><%= Money.minor_to_decimal(transaction.amount_minor, exponent: Money::EXPONENTS["USD"]) %>]
                </a>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </main>

  <footer>
    <%= render BottomNavigationComponent.new(month: @month) %>
  </footer>
</div>
