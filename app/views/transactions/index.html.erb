<div class="app-shell">
  <header>
    <%= render BudgetCalenderComponent.new(month: @month) %>
  </header>

  <main>
    <h1>All Transactions</h1>

    <ul>
      <% @transactions_by_date.each do |date, entries| %>
        <li>
          <strong><%= date.strftime("%B %d, %Y") %></strong>
          <ul>
            <%= render TransactionListItemComponent.with_collection(entries) %>
          </ul>
        </li>
      <% end %>
    </ul>
  </main>

  <footer>
    <%= render BottomNavigationComponent.new(month: @month) %>
  </footer>
</div>
