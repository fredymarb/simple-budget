<li>
  <%= link_to edit_transaction_path(transaction), class: "row-link" do %>
    <% if transfer? %>
      <span class="title"><%= label %></span>
      <span class="amount neutral"><%= amount %></span>
    <% else %>
      <span class="title"><%= transaction.category.name %></span>
      <span class="amount <%= transaction.amount_minor.negative? ? "negative" : "positive" %>"><%= amount %></span>
    <% end %>
  <% end %>
</li>
